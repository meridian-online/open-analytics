# The R2 write credential for the open lake (bucket meridian-open). With all three set,
# from a .env here or from the environment, EVERY `arc run` publishes into the live lake;
# `arc run --publish` only makes a missing credential fail the run. For local work leave
# .env absent and these unset. Prefer a credential file kept outside this folder.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
